ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL/Supabase connection string. Gunakan connection pooler untuk deployment serverless.
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# Opsional untuk pengembangan/QA tanpa database: gunakan data/content.json.
# Jangan gunakan mode json pada deployment production multi-instance.
CONTENT_STORAGE_MODE=postgres

# Opsional. Isi "require" bila provider database mewajibkan TLS.
DATABASE_SSL=require
# Opsional bila CA provider tidak tersedia di trust store sistem. Gunakan PEM, boleh memakai literal \n.
DATABASE_CA_CERT=

# Aktifkan hanya pada server yang memiliki persistent disk. Jangan aktifkan di Vercel/serverless.
ALLOW_LOCAL_UPLOADS=false

# Opsional: sinkronisasi konten ke workflow eksternal.
N8N_SYNC_WEBHOOK=
